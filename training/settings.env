# Every setting here was chosen by measurement, not preference. The reasoning is
# in docs/EXPERIMENTS.md; the short version is in each comment.

# --- dataset ------------------------------------------------------------------
# Recorded at 30 Hz the servo tracks its target within a degree, so the action
# label is a copy of the next observed state and a policy scores well by echoing
# its input. Keeping every 3rd frame triples the per-step motion (0.59 -> 1.73
# deg), so echoing costs three times as much across a chunk. Stride 5 is
# unusable: replaying the expert's own actions at 6 Hz topples pieces (11/80).
STRIDE=3
RECORDED_FPS=30                 # so the exported dataset is 10 Hz
# Recorded with --randomize: colours and lighting, and since 2026-09-14 the
# board shifted up to 10 mm each way and the arm starting up to 0.1 rad off its
# parked pose. Also the first recordings after the contact fix that stopped
# pieces sinking through the board. New directories, because build_dataset.sh
# skips collection into any directory that already holds enough episodes.
MOVE_RECORDINGS=datasets/chess_moves_v4
CAPTURE_RECORDINGS=datasets/chess_captures_v4

# --- training -----------------------------------------------------------------
POLICY=molmoact2
BASE_CHECKPOINT=allenai/MolmoAct2-SO100_101      # pretrained on this exact arm
BATCH_SIZE=8                    # 8 with gradient checkpointing peaks at ~30 GB
GRAD_ACCUM=1                    # raise with a smaller BATCH_SIZE on a smaller card;
                                # reducing the batch did not avoid the GPU resets here
NUM_WORKERS=4                   # 0 was tried against the hangs and changed nothing
LORA_RANK=64                    # 737M trainable of 5.6B
TOTAL_STEPS=70000               # 1.1 epochs: 505,241 frames / batch 8 = 63,155 steps
                                # per epoch. The first full run stopped at 0.28.
                                # The LR decay is sized to this, not LeRobot's 24,000.
BLOCK=10000                     # evaluate this often
SAVE_EVERY=500                  # the GPU reset under load (nvlddmkm event 153) at
                                # random steps; frequent saves keep each reset cheap.
                                # passed through to chess_sim.training
EVAL_EPISODES=32                # moves. 8 was too noisy (3/8,4/8,3/8 read as a plateau,
                                # the next block scored 12/16); single positions still
                                # swung between checkpoints at 16
EVAL_CAPTURES=16                # captures, scored in the same evaluation
EVAL_MAX_STEPS=450              # control steps per episode. 300 was shorter than 11-12%
                                # of the expert's own moves and captures; 450 covers 98-99%

# --- execution ----------------------------------------------------------------
# A policy trained at 10 Hz emits one target per 3 control periods. Holding each
# as a step asks the servo for the whole jump at once and topples pieces;
# ramping between them took the same checkpoint from 12/16 to 16/16, and the
# median placement error from 5.2 mm to 2.1 mm. Free, and it applies on the real
# robot too.
INTERPOLATE=1

# --- paths --------------------------------------------------------------------
DATASET_ROOT=datasets/lerobot/chess_mc     # moves and captures; chess_all also held restores
REPO_ID=XvKuoMing/so101_chess_mc           # a local label - nothing is pushed
OUTPUT_DIR=outputs/molmoact2_mc            # a new directory: train.sh resumes whatever it finds
