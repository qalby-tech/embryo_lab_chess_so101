# Continuing the 70,000-step policy on a rebalanced dataset. Everything not set
# here is the published run's setting.
source training/settings.env

# Captures were a fifth of the data and score 68% against moves' 80% at the
# shipped 30-action horizon (docs/EXPERIMENTS.md 5.7). This set adds 1,982
# captures, bringing them to 3,200 against 5,000 moves, plus the first DAgger
# corrections - episodes that start where the policy went wrong.
DATASET_ROOT=datasets/lerobot/chess_mc_v2
OUTPUT_DIR=outputs/molmoact2_mc_v2

# Continue from the published weights rather than the pretrained arm policy:
# the question is what the new data adds, not how fast a run converges.
INIT_FROM=outputs/molmoact2_mc/checkpoints/070000/pretrained_model
TOTAL_STEPS=15000               # about a fifth of an epoch of the new set, on top of 1.1
BLOCK=5000                      # evaluate three times
