# SmolVLA on the corrections set, from lerobot/smolvla_base. The first entry of
# the architecture comparison: same data, same 300-position test, each model at
# a three-second chunk. Everything not set here is the published run's setting.
source training/settings.env

POLICY=smolvla
BASE_CHECKPOINT=lerobot/smolvla_base
DATASET_ROOT=datasets/lerobot/chess_mc_dagger   # the set the best MolmoAct2 run trained on
OUTPUT_DIR=outputs/smolvla_mc
BATCH_SIZE=32                   # 450M parameters: a fraction of MolmoAct2's memory
TOTAL_STEPS=20000               # 640K samples, 0.7 epoch of the set; SmolVLA's own
                                # fine-tuning recipe is 20K steps
BLOCK=5000                      # evaluate four times
EVAL_CAPTURES=16
