# The wide run: the corrected policy continued on a training distribution a user's own
# setup falls inside - boards of different sizes and materials, twenty piece sets and
# coin-style tokens, the workspace camera anywhere from a mast to a tripod beside the
# table, the arm clamped where it fits, and the room's light and table varied.
# Everything not set here is the published run's setting.
source training/settings.env

DATASET_ROOT=datasets/lerobot/chess_mc_wide     # the wide export + the corrections set
OUTPUT_DIR=outputs/molmoact2_wide

# A warm start: the checkpoint already moves pieces on the published rig; what it has to
# learn is that the rig does not matter. The action expert at half its published rate -
# a tenth absorbed corrections from familiar scenes and would be too gentle for unfamiliar
# ones, the full rate dropped pieces - while the LoRA, vision encoder and connector run at
# their fixed 5e-5, the rate they learned the task at (docs/EXPERIMENTS.md 6). The
# schedule is sized to this run.
INIT_FROM=outputs/molmoact2_mc_v5/checkpoints/015000/pretrained_model
LR_SCALE=0.5
TOTAL_STEPS=60000
BLOCK=10000

# Each block is scored on sampled scenes, not the published one, and never on what the
# export held out of training.
EVAL_SCENES=8
HOLD_OUT_PIECE_SETS="marble token_disc_big"
HOLD_OUT_BOARD_FINISHES="cardboard"
