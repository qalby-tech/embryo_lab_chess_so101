# The wide training set from the pretrained base, not from a chess checkpoint.
# Both continuations of the published model collapsed on the wide data (docs/EXPERIMENTS.md
# 4.12 and 4.13): a policy fitted to one scene unlearns it faster than it learns the
# others, whatever the action expert's rate, because the LoRA trains at a fixed 5e-5
# either way. So this run starts where the published one started, with its rates, and
# sees every scene from the first step.
source training/settings.env

DATASET_ROOT=datasets/lerobot/chess_mc_wide2    # 26,336 episodes, 2,544,940 frames at 10 Hz
OUTPUT_DIR=outputs/molmoact2_wide_base

# The published run did 1.1 epochs of 505K frames in 70,000 steps. One epoch here is
# 318,000 steps at 2.2 s each; a full epoch is nine days, so this is 0.38 of one. The
# decay is sized to this count, and stretching a run past its schedule means a fresh
# start from a checkpoint with the scheduler reset - so the count errs long.
TOTAL_STEPS=120000
BLOCK=10000

# each block: eight sampled scenes, never the held-out sets or boards (48 episodes, the
# same check the continuations scored 3/48 on), plus the published rig (16 moves,
# 8 captures)
EVAL_SCENES=8
EVAL_HOME_EPISODES=16
HOLD_OUT_PIECE_SETS="marble token_disc_big"
HOLD_OUT_BOARD_FINISHES="cardboard"
