# The wide run, second attempt. Two things changed since docs/EXPERIMENTS.md 4.12: the
# camera and the board's placement now vary every episode (the first collection had
# some three hundred placements), and the continuation starts from the published
# 70,000-step checkpoint with the action expert at 5e-6 - its own floor, the restart
# three continuations survived - instead of a fifty-fold re-heat of the corrected one.
source training/settings.env

DATASET_ROOT=datasets/lerobot/chess_mc_wide2    # new wide export + first wide export + corrections set
OUTPUT_DIR=outputs/molmoact2_wide2

INIT_FROM=outputs/molmoact2_mc/checkpoints/070000/pretrained_model
LR_SCALE=0.1
TOTAL_STEPS=60000
BLOCK=10000

# each block: eight sampled scenes, never the held-out sets or boards, plus the
# published rig (16 moves, 8 captures) so forgetting shows at the first block
EVAL_SCENES=8
EVAL_HOME_EPISODES=16
HOLD_OUT_PIECE_SETS="marble token_disc_big"
HOLD_OUT_BOARD_FINISHES="cardboard"
