# SmolVLA again, with the whole model trainable. The first run froze the vision
# encoder and the language model (SmolVLA's defaults) and trained only the action
# expert; a frozen 500M VLM may not localise a 28 mm square finely enough.
source training/settings.smolvla.env
OUTPUT_DIR=outputs/smolvla_full_mc
POLICY_FLAGS="--policy.train_expert_only=false --policy.freeze_vision_encoder=false"
